# .env.example — copy to .env and fill in real values. Never commit .env itself.

# ─── Database ────────────────────────────────────────────────
# PostgreSQL + Database Connection (Default: SQLite local database; use PostgreSQL for production)
# leave empty or set to sqlite:///./drishti_landslide.db
DATABASE_URL=sqlite:///./drishti_landslide.db

# ─── Pilot Region Config (East Khasi Hills, Meghalaya) ───────
PILOT_DISTRICT_NAME=East Khasi Hills, Meghalaya
PILOT_CENTER_LAT=25.5788
PILOT_CENTER_LON=91.8933
# Bounding box for OSM/Overpass and terrain queries: south,west,north,east
PILOT_BBOX=25.10,91.25,25.75,92.15

# ─── Weather & Soil Moisture — Open-Meteo (no key required) ─
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ─── Rainfall — IMD Public API (public endpoints, no key required) ─
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1

# ─── Terrain / Slope ─────────────────────────────────────────
# Open Topo Data: free public API, no key, rate-limited (~1000 calls/day)
OPEN_TOPO_DATA_URL=https://api.opentopodata.org/v1

# OpenTopography: only needed if pulling bulk DEM rasters for the whole pilot area.
# Get a free key at https://portal.opentopography.org (MyOpenTopo Dashboard > Get an API Key)
OPENTOPOGRAPHY_API_KEY=

# ─── Roads / Villages — Overpass API (no key required) ───────
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ─── Translation — LibreTranslate ─────────────────────────────
# Hosted free instance (no key) or your own self-hosted URL. If self-hosting with an
# API key enabled, set LIBRETRANSLATE_API_KEY too.
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# ─── SMS Alerts — Fast2SMS ─────────────────────────────────────
# Sign up free at https://www.fast2sms.com, get key from Dashboard > Dev API
FAST2SMS_API_KEY=

# ─── Push Notifications — Firebase Cloud Messaging ────────────
# Create a free project at https://console.firebase.google.com, then
# Project Settings > Cloud Messaging for these values
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# ─── Alert Logic ────────────────────────────────────────────
# Risk score (0-100) at which an alert auto-triggers
RISK_ALERT_THRESHOLD=70
# Comma-separated language codes for alert templates, e.g. en,hi,kha,as
ALERT_LANGUAGES=en,hi,kha,as

# ─── App Config ──────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
PORT=8000
