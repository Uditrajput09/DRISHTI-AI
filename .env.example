# ==============================================================================
# DRISHTI-AI Environment Configuration Example
# Copy this file to .env and fill in your actual API keys.
# ==============================================================================

# Database Connection (Primary: PostgreSQL/PostGIS; fallback to SQLite if PostgreSQL service is offline)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drishti_landslide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drishti_landslide
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pilot District Settings (Default: East Khasi Hills, Meghalaya)
PILOT_DISTRICT_NAME=East Khasi Hills, Meghalaya
PILOT_CENTER_LAT=25.5788
PILOT_CENTER_LON=91.8933
PILOT_BBOX=25.10,91.25,25.75,92.15

# Open-Meteo & OpenTopoData Ingestion Endpoints
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
OPEN_TOPO_DATA_URL=https://api.opentopodata.org/v1
OPENTOPOGRAPHY_API_KEY=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Multilingual Translation (LibreTranslate)
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# Google Gemini AI Chatbot Key
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# SMS Alerts (Fast2SMS for Indian mobile numbers)
# Get a free account at: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Firebase Cloud Messaging (FCM Web Push)
# Configure at: https://console.firebase.google.com/
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=

# Risk Thresholds and App Settings
RISK_ALERT_THRESHOLD=70
ALERT_LANGUAGES=en,hi,kha,as
ENVIRONMENT=development
DEBUG=true
PORT=8000
